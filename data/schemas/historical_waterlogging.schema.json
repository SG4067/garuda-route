{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical waterlogging location record",
  "description": "One source-named location record for a documented event. Rainfall and severity may be event context rather than road measurements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "event_id", "source_record_id", "road_id", "road_name",
    "location_name", "location_precision", "city", "latitude", "longitude",
    "event_date", "event_date_start", "event_date_end", "event_date_raw",
    "rainfall_amount_mm", "rainfall_scope", "rainfall_scope_period",
    "rainfall_is_road_specific", "rainfall_duration_minutes",
    "rainfall_duration_qualifier", "rainfall_duration_text",
    "rainfall_intensity_mm_hr", "severity", "severity_scope", "description",
    "source_name", "source_url", "evidence_status", "confidence",
    "threshold_status", "threshold_assessment", "threshold_limitations",
    "is_priority_location", "review_flags", "source_sheet", "source_excel_row",
    "source_city_raw", "source_location_raw", "source_event_date_raw",
    "source_rainfall_amount_raw", "source_rainfall_scope_raw",
    "source_duration_raw", "source_severity_context_raw",
    "source_evidence_note_raw", "source_priority_label_raw"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^HIST-LOC-[0-9]{4}$"},
    "event_id": {"type": "string", "pattern": "^EVT-[0-9a-f]{12}$"},
    "source_record_id": {"type": "string", "minLength": 1},
    "road_id": {"type": ["string", "null"]},
    "road_name": {"type": ["string", "null"]},
    "location_name": {"type": ["string", "null"]},
    "location_precision": {"enum": ["NOT_ASSESSED", "AREA_ONLY", "UNKNOWN"]},
    "city": {"enum": ["Kanpur", "Gurugram"]},
    "latitude": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "longitude": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "event_date": {"type": ["string", "null"], "format": "date"},
    "event_date_start": {"type": ["string", "null"], "format": "date"},
    "event_date_end": {"type": ["string", "null"], "format": "date"},
    "event_date_raw": {"type": "string", "minLength": 1},
    "rainfall_amount_mm": {"type": ["number", "null"], "minimum": 0},
    "rainfall_scope": {"enum": ["CITY_TOTAL", "DISTRICT_TOTAL", "WEATHER_STATION", "UNKNOWN"]},
    "rainfall_scope_period": {"type": "string"},
    "rainfall_is_road_specific": {"type": "boolean"},
    "rainfall_duration_minutes": {"type": ["number", "null"], "minimum": 0},
    "rainfall_duration_qualifier": {"enum": ["EXACT", "APPROXIMATE", "AT_LEAST", "UNKNOWN"]},
    "rainfall_duration_text": {"type": "string"},
    "rainfall_intensity_mm_hr": {"type": ["number", "null"], "minimum": 0},
    "severity": {"type": ["string", "null"]},
    "severity_scope": {"enum": ["EVENT_CONTEXT", "LOCATION_SPECIFIC", "UNKNOWN"]},
    "description": {"type": ["string", "null"]},
    "source_name": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri", "minLength": 1},
    "evidence_status": {"enum": ["UNVERIFIED", "REQUIRES_REVIEW", "VERIFIED", "REJECTED"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "threshold_status": {"enum": ["OBSERVED", "DERIVED", "ESTIMATED", "UNKNOWN"]},
    "threshold_assessment": {"const": "INSUFFICIENT EVIDENCE FOR THRESHOLD"},
    "threshold_limitations": {"type": "string", "minLength": 1},
    "is_priority_location": {"type": "boolean"},
    "review_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["CONFLICTING_PUBLISHED_RAINFALL_CONTEXT", "OVERLAPPING_SOURCE_REPORTS_SAME_LOCATION_DATE"]}
    },
    "source_sheet": {"const": "Citywide incidents"},
    "source_excel_row": {"type": "integer", "minimum": 6},
    "source_city_raw": {"type": "string", "minLength": 1},
    "source_location_raw": {"type": "string"},
    "source_event_date_raw": {"type": "string", "minLength": 1},
    "source_rainfall_amount_raw": {"type": ["number", "string", "null"]},
    "source_rainfall_scope_raw": {"type": "string"},
    "source_duration_raw": {"type": "string"},
    "source_severity_context_raw": {"type": "string"},
    "source_evidence_note_raw": {"type": "string"},
    "source_priority_label_raw": {"type": "string"}
  }
}
