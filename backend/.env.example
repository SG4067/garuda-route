GARUDAROUTE_APP_NAME=GarudaRoute API
GARUDAROUTE_ENVIRONMENT=development
GARUDAROUTE_DEBUG=false
# Optional. Configure an evidence-backed roads file before enabling risk routes.
# Do not point this at synthetic demo thresholds for real traveller alerts.
# GARUDAROUTE_RISK_ROADS_FILE=../data/roads.json
# Explicit mapping only; unmapped roads return UNKNOWN / UNMAPPED.
# GARUDAROUTE_RISK_ROAD_TO_LOCATION_JSON={"ROAD_ID":"LOCATION_ID"}
